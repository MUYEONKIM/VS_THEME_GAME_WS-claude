# Copy this file to .env and fill in your own values. .env is git-ignored.

# Local dev server binding.
PORT=3010
HOST=0.0.0.0

# Password for the in-game "Add photos" and photo delete controls.
# In production set it as a Worker secret instead of putting it here:
#   npx wrangler secret put UPLOAD_PASSWORD --name <your-worker-name>
UPLOAD_PASSWORD=choose-a-private-upload-password

# Cloudflare resources. Create them once, then paste the ids in:
#   npx wrangler kv namespace create MEMORY_IMAGES
#   npx wrangler d1 create arcade-stats
# WORKER_NAME becomes the first label of the workers.dev URL:
#   https://<WORKER_NAME>.<your-subdomain>.workers.dev
WORKER_NAME=covert-code-arcade
MEMORY_IMAGES_KV_ID=00000000000000000000000000000000
STATS_D1_NAME=arcade-stats
STATS_D1_ID=00000000-0000-4000-8000-000000000000
